# ============================================================
# 本文件是模板，复制为 .env 后在本地使用；.env 已被 .gitignore 忽略，切勿提交真实值。
# Cloudflare Workers 运行所需的 SESSION_SECRET / ADMIN_PASSWORD 属于「机密」，
# 请改用 `wrangler secret put` 写入（见 README 部署章节），不要写进任何文件。
# ============================================================

# --- 本地工具 / 部署脚本用（非机密）---
# Cloudflare 账户 ID，可在 https://dash.cloudflare.com 右侧获取
CLOUDFLARE_ACCOUNT_ID=your-account-id

# 具备 D1「编辑」权限的 Cloudflare API Token（机密，切勿提交）
# 创建地址：https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# --- 以下两项仅供本地参考，真正生效的是 wrangler secret put 写入的值 ---
# 会话 HMAC 签名密钥： openssl rand -hex 32
SESSION_SECRET=replace-with-a-64-char-hex-string
# 管理员主密钥：用作 /admin/register 邀请码 与 /admin/forgot 找回验证
ADMIN_PASSWORD=replace-with-a-strong-master-key
