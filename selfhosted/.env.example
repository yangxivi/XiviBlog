# ===== XiviBlog 自托管版配置 =====
# 复制本文件为 .env 后修改。切勿把 .env 提交到仓库。

# 会话签名密钥：请改为随机长字符串，例如 `openssl rand -hex 32`
SESSION_SECRET=change-me-to-a-random-secret

# 后台注册邀请码 / 主密钥：访客通过 /admin/register 创建管理员时需要
ADMIN_PASSWORD=change-me-master-key

# SQLite 数据库文件路径（相对或绝对）。目录会自动创建。
DATABASE_PATH=./data/xiviblog.db

# 站点对外访问地址（用于生成 sitemap / rss 等绝对链接）
SITE_URL=http://localhost:3000

# Node 监听端口（next start 使用）
PORT=3000

# 安装向导硬锁：装完之后建议置 1，彻底关闭安装向导与 /api/install。
# 置 1 后 /install 直接 404，任何情况下都无法再走安装流程（想重装需先移除该变量，
# 并清空数据库文件与同目录下的 .installed 标记）。
XIVIBLOG_INSTALL_LOCK=0

# ===== 可选：AI 封面（agnes 等兼容接口）=====
# 留空则改用后台「站点设置 → AI 封面」里填写的 Key
# AGNES_API_KEY=
# AI_COVER_API_KEY=
